import sys

def evaluate_quote(material, weight_kg, supplier_quote):
    # 1. 기준 원자재 단가 (원/kg) - 필요에 따라 수정
    MATERIAL_RATES = {
        "steel": 1200,      # 철/강재 기준 단가
        "aluminum": 3500,   # 알루미늄 기준 단가
        "copper": 13000     # 구리 기준 단가
    }

    # 2. 표준 가공비 및 고정 경비 (원)
    PROCESSING_FEE = 800
    FIXED_OVERHEAD = 300

    mat_key = material.lower()
    if mat_key not in MATERIAL_RATES:
        return f"❌ 지원하지 않는 재질입니다. ({', '.join(MATERIAL_RATES.keys())} 중 선택)"

    # 목표 원가 산출: 재료비 + 가공비 + 경비
    base_material_cost = MATERIAL_RATES[mat_key] * weight_kg
    target_cost = base_material_cost + PROCESSING_FEE + FIXED_OVERHEAD

    # 타당성 편차 계산 (%)
    variance_rate = ((supplier_quote - target_cost) / target_cost) * 100

    print("=" * 45)
    print(" 📊 견적 타당성 분석 결과")
    print("=" * 45)
    print(f"• 적용 재질: {material.upper()} (단가: {MATERIAL_RATES[mat_key]:,}원/kg)")
    print(f"• 부품 중량: {weight_kg:.3f} kg")
    print(f"• 이론 재료비: {int(base_material_cost):,} 원")
    print(f"• 표준 제조원가(목표가): {int(target_cost):,} 원")
    print(f"• 협력사 제출 견적가: {supplier_quote:,} 원")
    print("-" * 45)

    # 판정 기준 (+10% 초과 시 재협상 권고, -15% 이하 시 저가 수주 확인)
    if variance_rate > 10:
        status = "🔴 [부적합 / 재협상 필요]"
        reason = f"목표 원가 대비 +{variance_rate:.1f}% 과다 책정되었습니다. (가공비/마진 소명 요청 권장)"
    elif variance_rate < -15:
        status = "🟡 [주의 / 품질 확인 필요]"
        reason = f"목표 원가 대비 {abs(variance_rate):.1f}% 낮습니다. (사양 누락 여부 확인 권장)"
    else:
        status = "🟢 [적합 / 승인 가능]"
        reason = f"목표 원가 대비 오차 범위 내({variance_rate:+.1f}%)로 타당한 견적입니다."

    print(f"판정: {status}")
    print(f"사유: {reason}")
    print("=" * 45)

if __name__ == "__main__":
    print("=== 견적 타당성 검토 시스템 ===")
    mat = input("1. 재질 입력 (steel / aluminum / copper): ").strip()
    try:
        wt = float(input("2. 중량(kg) 입력: ").strip())
        quote = int(input("3. 협력사 견적가(원) 입력: ").strip())
        evaluate_quote(mat, wt, quote)
    except ValueError:
        print("⚠️ 숫자 입력란에 올바른 숫자를 넣어주세요.")
